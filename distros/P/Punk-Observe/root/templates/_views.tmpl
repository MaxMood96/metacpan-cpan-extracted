{% if saved_views %}
<div class="views">
  <span class="note">Saved:</span>
  {% for v in saved_views %}
  <a class="viewlink" href="{% prefix %}/{% save_path %}?{% v.params %}"
     title="{% v.query %}">{% v.name %}<span class="viewwin">{% v.window %}</span></a>
  {% end %}
</div>
{% end %}

{% if writable %}
<form method="post" action="{% prefix %}/views" class="savebar">
  {% raw csrf_field %}
  <input type="hidden" name="page" value="{% save_page %}">
  <input type="hidden" name="q" value="{% query %}">
  <input type="hidden" name="range" value="{% range %}">
  {% if range_custom %}
  <input type="hidden" name="from" value="{% from %}">
  <input type="hidden" name="to" value="{% to %}">
  {% end %}
  <input type="hidden" name="service" value="{% service %}">
  <input type="hidden" name="min_ms" value="{% min_ms %}">
  <input type="text" name="name" size="18" placeholder="name this view"
         aria-label="Name this view">
  <button type="submit">Save</button>
</form>
{% end %}
