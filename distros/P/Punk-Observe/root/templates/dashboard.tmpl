<div class="toolbar">
  <h2 style="margin:0">{% title %}</h2>
  <div style="flex:1"></div>
  {% if can_edit %}
  <a class="btn" href="{% prefix %}/dashboards/{% slug %}/edit">Edit</a>
  {% end %}
</div>

{% if error %}
<div class="warnbox"><strong>{% error %}</strong>{% if hint %} {% hint %}{% end %}</div>
{% end %}

{% if list %}
<div class="panel">
  <h2>Dashboards</h2>
  <div class="tablewrap">
    <table class="rows">
      <tbody>
      {% for d in list %}
      <tr><td><a href="{% prefix %}/dashboards/{% d.slug %}">{% d.title %}</a></td></tr>
      {% end %}
      </tbody>
    </table>
  </div>
</div>
{% end %}

<div class="grid cols-{% cols %}" data-charts>
  {% for p in panels %}
  <div class="panel span-{% p.span %}">
    <h3>{% p.title %}</h3>
    {% if p.refusal %}
    <div class="warnbox"><strong>Cannot answer that from this range.</strong>
      {% p.refusal %}</div>
    {% else %}
    {% if p.series %}
    <div class="chartwrap" data-brush data-from="{% from %}" data-to="{% to %}">
      <svg class="chart" viewBox="0 0 720 220" role="img" aria-label="{% p.title %}">
        {% for t in p.yticks %}
        <line class="axis" x1="0" y1="{% t.y %}" x2="720" y2="{% t.y %}"/>
        <text class="label" x="2" y="{% t.label_y %}">{% t.label %}</text>
        {% end %}
        {% for s in p.series %}
        <g class="{% s.class %}"><path class="line" d="{% s.path %}"/></g>
        {% end %}
      </svg>
    </div>
    {% end %}
    {% if p.groups %}
    <div class="tablewrap">
      <table class="rows">
        <tbody>
        {% for g in p.groups %}
        <tr><td>{% g.key %}</td><td class="num mono">{% g.value %}</td></tr>
        {% end %}
        </tbody>
      </table>
    </div>
    {% end %}
    {% end %}
    <p class="note"><a href="{% prefix %}/explore?q={% p.query_esc %}{% range_amp %}">
      open in the explorer</a></p>
  </div>
  {% end %}
</div>

{% if panels %}{% else %}
{% if configured %}
<p class="empty">This dashboard has no panels yet.</p>
{% else %}
<p class="empty">No dashboard source is configured. Pass
  <code class="mono">dashboards</code> to the plugin with a reader for
  wherever your dashboards are kept.</p>
{% end %}
{% end %}
