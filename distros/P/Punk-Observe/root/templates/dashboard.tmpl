<div class="toolbar">
  <h2 style="margin:0">{% title %}</h2>
  <div style="flex:1"></div>
  <form method="get"
        action="{% prefix %}/dashboards{% if slug %}/{% slug %}{% end %}"
        style="display:contents">
    {% include _range.tmpl %}
  </form>
  {% if writable %}
  <a class="btn" href="{% prefix %}/dashboards/new">New</a>
  {% if slug %}<a class="btn" href="{% prefix %}/dashboards/{% slug %}/edit">Edit</a>{% end %}
  {% end %}
</div>

{% if error %}
<div class="warnbox"><strong>{% error %}</strong>{% if hint %} {% hint %}{% end %}</div>
{% end %}

{% if list %}
<div class="panel">
  <h2>Dashboards</h2>
  <div class="tablewrap">
    <table class="rows">
      <tbody>
      {% for d in list %}
      <tr><td><a href="{% prefix %}/dashboards/{% d.slug %}{% range_qs %}">{% d.title %}</a></td></tr>
      {% end %}
      </tbody>
    </table>
  </div>
</div>
{% end %}

<div class="grid cols-{% cols %}" data-charts>
  {% for p in panels %}
  <div class="panel span-{% p.span %}">
    <h3>{% p.title %}</h3>
    {% if p.body_html %}
    {% raw p.body_html %}
    {% else %}
    <div class="deferwrap"
         data-defer="{% prefix %}/dashboards/{% slug %}/panels/{% p.key %}/slow{% range_qs %}"
         data-defer-poll="30">
      <p class="empty">Loading&hellip;</p>
      <noscript><p class="note">This panel loads after the page, which needs
        JavaScript - or
        <a href="{% prefix %}/dashboards/{% slug %}?full=1{% range_amp %}">render
        everything with the page</a>.</p></noscript>
    </div>
    {% end %}
    <p class="note"><a href="{% prefix %}/explore?q={% p.query_esc %}{% range_amp %}">
      open in the explorer</a></p>
  </div>
  {% end %}
</div>

{% if panels %}{% else %}
{% if configured %}
<p class="empty">This dashboard has no panels yet.</p>
{% else %}
<p class="empty">No dashboard source is configured. Pass
  <code class="mono">dashboards</code> to the plugin with a reader for
  wherever your dashboards are kept.</p>
{% end %}
{% end %}
