{% if found %}
<div class="panel">
  <div class="recordhead">
    <span class="sev sev-{% record.sev_name %}">{% record.sev_name %}</span>
    <span class="mono">{% record.date %}</span>
    <span>{% record.service %}</span>
    {% if record.trace %}
    <a class="tracelink" href="{% prefix %}/traces/{% record.trace %}{% range_qs %}">open the trace</a>
    {% end %}
  </div>
  <pre class="body mono">{% record.body %}</pre>
</div>

<div class="panel">
  <h2>Attributes</h2>
  {% if attrs %}
  <div class="tablewrap">
    <table>
      <thead><tr><th>key</th><th>value</th></tr></thead>
      <tbody>
      {% for a in attrs %}
      <tr><td class="mono nowrap">{% a.key %}</td><td class="mono">{% a.value %}</td></tr>
      {% end %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty">This record carries no attributes. That is usually an
    exporter with no resource attributes configured, not a missing feature.</p>
  {% end %}
</div>

<div class="panel">
  <h2>Around it</h2>
  {% if context %}
  <div class="tablewrap">
    <table class="rows">
      <tbody>
      {% for c in context %}
      <tr class="{% if c.current %}current{% end %}">
        <td class="mono nowrap"><a href="{% prefix %}/logs/{% c.id %}{% range_qs %}">{% c.time %}</a></td>
        <td><span class="sev sev-{% c.sev_name %}">{% c.sev_name %}</span></td>
        <td class="nowrap">{% c.service %}</td>
        <td class="mono body">{% c.body %}</td>
      </tr>
      {% end %}
      </tbody>
    </table>
  </div>
  {% else %}
  <p class="empty">Nothing else was logged within five seconds.</p>
  {% end %}
</div>
{% else %}
<div class="panel">
  <p class="empty">That record is not in the store. It may have aged out of
    the retention window, or the link may be truncated.</p>
  <p><a href="{% prefix %}/logs{% range_qs %}">Back to the logs</a></p>
</div>
{% end %}
