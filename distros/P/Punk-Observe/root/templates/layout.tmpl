<!doctype html>
<html lang="en" data-theme="{% theme | default('') %}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% title | default('Punk::Observe') %}</title>
{% if wants_range %}
<link rel="stylesheet" href="{% prefix %}/assets/daterangepicker.css">
{% end %}
<link rel="stylesheet" href="{% prefix %}/assets/observe.css">
<link rel="icon" href="{% prefix %}/assets/favicon.svg" type="image/svg+xml">
<script>
/* The saved theme, applied BEFORE THE FIRST PAINT. In the body this same
 * three lines would flash the default theme and then correct it, which reads
 * as the page being broken rather than as the page being themed. */
(function () {
  try {
    var t = localStorage.getItem('po-theme');
    if (t) document.documentElement.setAttribute('data-theme', t);
  } catch (e) {}
})();
</script>
</head>
<body>
<div class="shell">

  <div class="brand"><a href="{% prefix %}/">Punk::Observe</a></div>

  <header class="head">
    <h1 style="margin:0;font-size:var(--fs-lg)">{% heading | default('') %}</h1>
    <div style="flex:1"></div>
    {% raw toolbar %}
    <select id="theme" aria-label="Colour theme">
      <option value="">System</option>
      <option value="dark">Dark</option>
      <option value="light">Light</option>
    </select>
  </header>

  <nav class="nav" aria-label="Sections">
    <a href="{% prefix %}/{% range_qs %}"          {% if here_home %}aria-current="page"{% end %}>Overview</a>
    <a href="{% prefix %}/dashboards{% range_qs %}" {% if here_dashboard %}aria-current="page"{% end %}>Dashboards</a>
    <a href="{% prefix %}/explore{% range_qs %}"   {% if here_explore %}aria-current="page"{% end %}>Explore</a>
    <a href="{% prefix %}/health{% range_qs %}"    {% if here_health %}aria-current="page"{% end %}>Health</a>
    <a href="{% prefix %}/metrics{% range_qs %}"   {% if here_metrics %}aria-current="page"{% end %}>Metrics</a>
    <a href="{% prefix %}/traces{% range_qs %}"    {% if here_traces %}aria-current="page"{% end %}>Traces</a>
    <a href="{% prefix %}/logs{% range_qs %}"      {% if here_logs %}aria-current="page"{% end %}>Logs</a>
    <a href="{% prefix %}/alerts{% range_qs %}"    {% if here_alerts %}aria-current="page"{% end %}>Alerts</a>
    <a href="{% prefix %}/map{% range_qs %}"       {% if here_map %}aria-current="page"{% end %}>Service map</a>
    <a href="{% prefix %}/help{% range_qs %}"      {% if here_help %}aria-current="page"{% end %}>Help</a>
  </nav>

  <main class="main">
    {% content %}
  </main>

</div>

<script src="{% prefix %}/assets/nsmath.js" defer></script>
<script src="{% prefix %}/assets/brush.js" defer></script>
<script src="{% prefix %}/assets/waterfall.js" defer></script>
<script src="{% prefix %}/assets/flamegraph.js" defer></script>
<script src="{% prefix %}/assets/livetail.js" defer></script>
<script src="{% prefix %}/assets/discover.js" defer></script>
{% if wants_plot %}
<script src="{% prefix %}/assets/plotly.min.js" defer></script>
<script src="{% prefix %}/assets/plot.js" defer></script>
<script src="{% prefix %}/assets/defer.js" defer></script>
{% end %}
{% if wants_range %}
<script src="{% prefix %}/assets/moment.min.js" defer></script>
<script src="{% prefix %}/assets/daterangepicker.js" defer></script>
<script src="{% prefix %}/assets/daterange.js" defer></script>
{% end %}

<script>
/* The theme CONTROL. The saved value was already applied in the head; this
 * only has to reflect it and write changes back. */
(function () {
  var sel = document.getElementById('theme');
  if (!sel) return;
  var saved = null;
  try { saved = localStorage.getItem('po-theme'); } catch (e) {}
  sel.value = saved || '';
  sel.addEventListener('change', function () {
    if (sel.value) document.documentElement.setAttribute('data-theme', sel.value);
    else document.documentElement.removeAttribute('data-theme');
    try {
      if (sel.value) localStorage.setItem('po-theme', sel.value);
      else localStorage.removeItem('po-theme');
    } catch (e) {}
  });
})();
</script>
</body>
</html>
