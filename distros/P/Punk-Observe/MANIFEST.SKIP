# The precompressed assets, generated by Makefile.PL from the file beside
# them. Shipping both would put two copies of the same bytes in the tarball
# and make drift between them possible; deriving it at build time cannot
# drift.
^root/static/.*\.gz$

# The demo's runtime output: logs, write-ahead logs and per-worker summaries,
# all created by running it. `make manifest` will otherwise ship whatever the
# last run happened to leave behind.
^example/var/
^example/var_
