<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% title | default('Passkey demo') %}</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header>
  <h1><a href="/">Punk::Plugin::Passkey</a></h1>
  <p class="lede">One keyword. No password anywhere in this
