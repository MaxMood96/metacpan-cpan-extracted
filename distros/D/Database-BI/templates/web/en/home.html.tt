[%- WRAPPER 'web/en/layouts/default.html.tt' -%]

[% IF error %]
<p class="error">[% error | html %]</p>
[% END %]

[%- IF back_url %]
<p class="back-link"><a href="[% back_url | html %]">&larr; [% back_label || 'Back' | html %]</a></p>
[%- END %]

[% IF tables.size %]
<ul class="db-list">
  [% FOREACH t IN tables %]
  <li>
    <a href="/view/[% t.name | uri %]" class="db-card">
      <span class="db-icon">&#128452;</span>
      <span class="db-name">[% t.name | html %]</span>
      <span class="db-file">[% t.file | html %]</span>
    </a>
  </li>
  [% END %]
</ul>
[% ELSE %]
<p class="empty-state">
  No data files found in the <code>data/</code> directory.<br>
  Add a <code>.csv</code>, <code>.psv</code>, <code>.xml</code> or <code>.sql</code> file there and restart, or drop a file below.
</p>
[% END %]

<div id="bi-recent"></div>

<div class="home-drop-zone" id="home-drop-zone" aria-label="Drop a database file here to open it">
  <span class="home-drop-zone-icon" aria-hidden="true">&#x1F4C2;</span>
  <span>Drop a database file to open it</span>
  <span class="home-drop-hint">CSV &middot; PSV &middot; XML &middot; SQLite (.sql)</span>
</div>

<div class="home-action-cards">

  <div class="action-card">
    <span class="action-card-icon" aria-hidden="true">&#128269;</span>
    <h2 class="action-card-title">Browse your files</h2>
    <p class="action-card-desc">Navigate your folders to find and open a data file stored on this computer.</p>
    <a href="/browse" class="btn-action">Browse filesystem&hellip;</a>
  </div>

  <div class="action-card">
    <span class="action-card-icon" aria-hidden="true">&#127760;</span>
    <h2 class="action-card-title">Import from a web page</h2>
    <p class="action-card-desc">Paste the address of any web page that contains a data table and we&rsquo;ll pull it in.</p>
    <form action="/import" method="GET" class="action-url-form">
      <input type="url" name="url" id="bi-url-input"
             placeholder="https://&hellip;"
             required autocomplete="off" class="action-url-input"
             aria-label="Web page URL">
      <div class="action-url-row">
        <label for="bi-table-idx" class="action-idx-label"
               title="If the page has more than one table, enter its position (0 = first)">
          Table # <input type="number" name="table_index" id="bi-table-idx"
                             min="0" value="0" class="action-idx-input">
        </label>
        <button type="submit" class="btn-action">Import</button>
      </div>
    </form>
  </div>

</div>

<script>
(function () {
  try {
    var recent = JSON.parse(localStorage.getItem('bi:recent') || '[]');
    if (!recent.length) return;

    function fmtDate(iso) {
      try {
        return new Date(iso).toLocaleString(undefined, {
          year: 'numeric', month: 'short', day: 'numeric',
          hour: '2-digit', minute: '2-digit',
        });
      } catch (e) { return iso; }
    }

    function fmtSize(bytes) {
      if (bytes == null) return '';
      if (bytes < 1024)             return bytes + ' B';
      if (bytes < 1024 * 1024)      return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function txt(s) {
      var d = document.createElement('span');
      d.textContent = s;
      return d.innerHTML;
    }

    var section = document.createElement('section');
    section.className = 'recent-section';
    var h2 = document.createElement('h2');
    h2.className = 'section-heading';
    h2.textContent = 'Recently opened';
    section.appendChild(h2);

    var ul = document.createElement('ul');
    ul.className = 'db-list';

    recent.forEach(function (r) {
      // Recover path from stored field or decode from href.
      var path = r.path || (function () {
        var m = r.href.match(/[?&]path=([^&]+)/);
        return m ? decodeURIComponent(m[1]) : null;
      }());

      var li = document.createElement('li');
      li.style.position = 'relative';

      var a = document.createElement('a');
      a.href = r.href;
      a.className = 'db-card';
      a.innerHTML = '<span class="db-icon" aria-hidden="true">&#128202;</span>'
                  + '<span class="db-name">' + txt(r.name) + '</span>';
      li.appendChild(a);

      // Build tooltip.
      var tip = document.createElement('div');
      tip.className = 'file-tooltip';
      tip.style.display = 'none';

      tip.innerHTML = '<div class="tip-name">' + txt(r.name) + '</div>'
        + (path ? '<div class="tip-path">&#x1F4C1; ' + txt(path) + '</div>' : '')
        + (!path && r.url ? '<div class="tip-path">&#x1F30D; ' + txt(r.url) + '</div>' : '')
        + (r.lastOpened ? '<div>\u{1F55B} Opened: ' + txt(fmtDate(r.lastOpened)) + '</div>' : '');

      var mtimeEl = document.createElement('div');
      var sizeEl  = document.createElement('div');
      sizeEl.className = 'tip-muted';
      tip.appendChild(mtimeEl);
      tip.appendChild(sizeEl);
      li.appendChild(tip);

      var statDone = false;

      a.addEventListener('mouseenter', function () {
        // Flip above/below based on viewport position.
        tip.style.display = 'block';
        var rect = tip.getBoundingClientRect();
        tip.classList.toggle('tip-below', rect.top < 0);

        if (statDone || !path) return;
        statDone = true;
        mtimeEl.innerHTML = '<span class="tip-muted">Loading…</span>';

        fetch('/api/stat?path=' + encodeURIComponent(path))
          .then(function (res) { return res.json(); })
          .then(function (d) {
            if (d.exists) {
              mtimeEl.innerHTML = '&#x1F4C5; Modified: '
                + txt(fmtDate(new Date(d.mtime * 1000).toISOString()));
              sizeEl.textContent = fmtSize(d.size);
            } else {
              mtimeEl.innerHTML = '<span class="tip-muted">⚠ File not found on disk</span>';
              sizeEl.textContent = '';
            }
          })
          .catch(function () { mtimeEl.textContent = ''; });
      });

      a.addEventListener('mouseleave', function () {
        tip.style.display = 'none';
      });

      ul.appendChild(li);
    });

    section.appendChild(ul);
    document.getElementById('bi-recent').appendChild(section);
  } catch (e) {}
}());
</script>

[%- END -%]
