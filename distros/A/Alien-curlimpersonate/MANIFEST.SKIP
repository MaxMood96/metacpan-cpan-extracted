#!include_default

# Alien build tree: the cloned upstream sources plus everything they build.
# ~25k files and ~700MB, including the .git of the clone -- without this the
# generated MANIFEST sweeps all of it into the tarball.
^_alien/

# local build/test logs
^\.tmp/
^\.tmp-mk\.log$

^\.git
^\.github/
^Alien-curlimpersonate-.*\.tar\.gz$
^MYMETA\.
^Makefile$
^pm_to_blib$
^blib/
